# OhMyPPT model runtime. Keep real credentials in .env only.
OPENAI_BASE_URL=https://api.deepseek.com
ANTHROPIC_BASE_URL=https://api.deepseek.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-flash-vision-exp
LLM_PROTOCOL=openai
OHMYPPT_ALLOW_LOCAL_BROWSER_DEFAULT=true
OHMYPPT_LLM_TIMEOUT=600
OHMYPPT_LLM_RETRIES=1
OHMYPPT_LLM_BATCH_SIZE=3
OHMYPPT_LLM_MAX_PARALLEL=2
# Verified production default; may be raised to the accepted 131072 ceiling.
OHMYPPT_LLM_MAX_TOKENS=32768
AGENT_RUNTIME_ALLOWED_HOSTS=api.deepseek.com,deepseek.com,localhost,127.0.0.1
