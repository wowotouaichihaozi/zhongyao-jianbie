.ask-card { border-top: 6rpx solid #176f4b; }
.ask-card textarea { border: 0; padding: 0; }
.ask { margin-top: 18rpx; }
.running { display: grid; grid-template-columns: 24rpx 1fr; gap: 14rpx; margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #c8ddd2; background: #edf5f1; color: #176f4b; }
.running-dot { width: 18rpx; height: 18rpx; margin-top: 7rpx; border-radius: 50%; background: #176f4b; }
.running view text { display: block; font-size: 24rpx; font-weight: 700; }
.running view text + text { margin-top: 6rpx; color: #68786f; font-size: 21rpx; font-weight: 400; }
.answer { margin-top: 26rpx; border-top: 6rpx solid #176f4b; }
.answer text { display: block; }
.answer-title { margin: 12rpx 0 18rpx; font-size: 31rpx; font-weight: 800; }
.answer-text { color: #3e5348; font-size: 25rpx; line-height: 1.8; white-space: pre-wrap; }
.evidence { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e0e8e4; }
.evidence text { padding: 14rpx; background: #edf5f1; color: #176f4b; font-size: 20rpx; }
.lesson { margin-top: 16rpx; }
.lesson > .section-title { display: block; }
.analogy { display: block; padding: 18rpx; border-left: 5rpx solid #a16f19; background: #fff8ec; color: #5f4a21; font-size: 23rpx; line-height: 1.65; }
.step { display: grid; grid-template-columns: 44rpx 1fr; gap: 12rpx; margin-top: 16rpx; color: #45594e; font-size: 23rpx; line-height: 1.6; }
.step text:first-child { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; background: #edf5f1; color: #176f4b; font-weight: 800; }
.line { padding: 16rpx 0; border-top: 1rpx solid #e2e9e5; color: #45594e; font-size: 23rpx; line-height: 1.6; }
.reference { padding: 14rpx 0; border-top: 1rpx solid #e2e9e5; }
.reference text { display: block; color: #3f5549; font-size: 22rpx; line-height: 1.5; }
.reference text + text { margin-top: 5rpx; color: #829087; font-size: 19rpx; }
.follow-up { position: sticky; bottom: 118rpx; z-index: 4; display: grid; grid-template-columns: 1fr 120rpx; gap: 10rpx; margin-top: 18rpx; padding: 12rpx; background: rgba(244, 247, 245, .95); }
.follow-up input { height: 84rpx; padding: 0 20rpx; border: 1rpx solid #cad8d1; border-radius: 10rpx; background: #fff; font-size: 23rpx; }
.follow-up button { min-height: 84rpx; padding: 0; font-size: 22rpx; }
