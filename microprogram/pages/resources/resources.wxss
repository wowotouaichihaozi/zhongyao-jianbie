.creator { margin-bottom: 34rpx; }
.type-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.type { min-height: 106rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; margin: 0; padding: 16rpx 18rpx; border: 1rpx solid #d6e1db; border-radius: 10rpx; background: #fff; color: #32473c; text-align: left; }
.type text { font-size: 24rpx; font-weight: 700; line-height: 1.4; }
.type text + text { margin-top: 4rpx; color: #78857e; font-size: 19rpx; font-weight: 400; }
.type.active { border-color: #176f4b; background: #edf5f1; color: #176f4b; }
.video-settings { margin-top: 18rpx; padding: 18rpx; border-left: 5rpx solid #a16f19; background: #fff8ec; color: #5f4a21; }
.video-settings view { font-size: 24rpx; }
.video-settings > text { display: block; margin-top: 10rpx; font-size: 20rpx; line-height: 1.5; }
.create { margin-top: 24rpx; }
.history-head { display: flex; align-items: center; justify-content: space-between; }
.task-card { margin-bottom: 14rpx; padding: 22rpx; border: 1rpx solid #d9e3de; border-radius: 12rpx; background: #fff; }
.task-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.task-head text { display: block; }
.task-title { margin-bottom: 6rpx; font-size: 25rpx; font-weight: 750; line-height: 1.4; }
.task-card .progress { margin-top: 18rpx; }
.task-time { display: block; margin-top: 12rpx; color: #88948e; font-size: 19rpx; }
.modal-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; padding: 24rpx; background: rgba(16, 28, 22, .55); }
.task-modal { width: 100%; max-height: 72vh; padding: 28rpx; border-radius: 16rpx 16rpx 8rpx 8rpx; background: #fff; }
.modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; font-size: 29rpx; font-weight: 800; }
.close { padding: 0 8rpx; color: #65756c; font-size: 42rpx; line-height: .8; }
.modal-progress { margin: 20rpx 0; }
.result-summary { display: block; max-height: 300rpx; margin: 20rpx 0; overflow: auto; color: #4c6055; font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }
.task-modal > button + button { margin-top: 12rpx; }
.feedback { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #e0e8e4; }
.rating { display: flex; gap: 8rpx; margin-bottom: 14rpx; }
.rating button { width: 70rpx; min-height: 64rpx; margin: 0; padding: 0; border: 1rpx solid #d9e3de; background: #fff; color: #aeb8b2; font-size: 33rpx; line-height: 64rpx; }
.rating button.active { border-color: #b58225; background: #fff8e9; color: #b58225; }
.feedback textarea { width: 100%; min-height: 120rpx; padding: 16rpx; border: 1rpx solid #cad8d1; border-radius: 10rpx; background: #fff; font-size: 22rpx; }
.feedback > button { margin-top: 14rpx; }
