page { height: 100%; overflow: hidden; }
.login-page { position: relative; height: 100vh; overflow: hidden; background: #0b2526; }
.background, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.background { object-position: 58% center; }
.shade { background: linear-gradient(90deg, rgba(4, 28, 20, .78), rgba(4, 28, 20, .2)); }
.brand-lockup { position: absolute; top: calc(30rpx + env(safe-area-inset-top)); left: 30rpx; display: flex; align-items: center; gap: 12rpx; color: #fff; filter: drop-shadow(0 4rpx 14rpx rgba(0,0,0,.25)); }
.brand { width: 82rpx; height: 82rpx; }
.brand-lockup text { display: block; font-size: 26rpx; font-weight: 800; }
.brand-lockup text + text { margin-top: 5rpx; color: rgba(255,255,255,.78); font-size: 18rpx; font-weight: 500; }
.glass { position: absolute; top: 50%; right: 30rpx; left: 30rpx; padding: 30rpx; border: 1rpx solid rgba(255,255,255,.72); border-radius: 16rpx; background: rgba(247,252,250,.74); box-shadow: 0 34rpx 80rpx rgba(2,20,22,.28); backdrop-filter: blur(22px) saturate(135%); transform: translateY(-50%); }
.intro { display: flex; flex-direction: column; padding-bottom: 22rpx; border-bottom: 1rpx solid rgba(67,100,87,.2); }
.eyebrow { color: #176f4b; font-size: 19rpx; font-weight: 800; }
.title { margin-top: 10rpx; color: #17231e; font-size: 38rpx; font-weight: 850; line-height: 1.25; }
.subtitle { margin-top: 9rpx; color: #5d6d65; font-size: 21rpx; line-height: 1.5; }
.identity { display: grid; grid-template-columns: 72rpx 1fr auto; align-items: center; gap: 15rpx; padding: 22rpx 0 5rpx; }
.admin-mark { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #176f4b; color: #fff; font-size: 25rpx; font-weight: 850; }
.identity text { display: block; color: #21362c; font-size: 25rpx; font-weight: 750; }
.identity view text + text { margin-top: 5rpx; color: #66788a; font-size: 20rpx; font-weight: 600; }
.identity .secure { padding: 9rpx 12rpx; border-radius: 8rpx; background: rgba(237,245,241,.9); color: #176f4b; font-size: 18rpx; font-weight: 800; }
.field { margin-top: 17rpx; }
.field-label { margin-bottom: 8rpx; }
.field-input { border-color: rgba(74,108,94,.3); background: rgba(255,255,255,.78); }
.submit { margin-top: 22rpx; }
.note { display: block; margin-top: 14rpx; color: #748179; font-size: 19rpx; text-align: center; }
@media (max-height: 720px) { .glass { padding: 22rpx 26rpx; } .title { font-size: 33rpx; } .field-input { height: 78rpx; } .field { margin-top: 11rpx; } }
